# 复制为 .env 后再启动：cp .env.example .env

# --- Elasticsearch ---
ES_VERSION=8.13.4
ES_PORT=9200
# 单机开发用 1g 即可；机器内存大可调到 2g
ES_JAVA_OPTS=-Xms1g -Xmx1g

# --- MongoDB ---
MONGO_VERSION=6.0
MONGO_PORT=27017
MONGO_USER=isr
MONGO_PASSWORD=isr_dev_pw
MONGO_DB=isr

# --- Tika ---
TIKA_VERSION=2.9.2.1-full
TIKA_PORT=9998
