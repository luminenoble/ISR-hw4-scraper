# 复制为 .env 后再启动：cp .env.example .env

# --- Elasticsearch ---
ES_VERSION=8.13.4
ES_PORT=9200
# 单机开发用 1g 即可；机器内存大可调到 2g
ES_JAVA_OPTS=-Xms1g -Xmx1g

# --- MongoDB ---
MONGO_VERSION=6.0
MONGO_PORT=27017
MONGO_USER=isr
MONGO_PASSWORD=isr_dev_pw
MONGO_DB=isr

# --- Tika ---
TIKA_VERSION=2.9.2.1-full
TIKA_PORT=9998

# --- 爬虫身份 ---
# UA 中的项目名 + 联系邮箱（Wikipedia / Fandom 都要求 UA 含联系方式）
ISR_UA_NAME=ISR-CourseProject
ISR_CONTACT_EMAIL=isr-course@example.com

# --- Wikipedia Bot Password（可选；不填则匿名 + ROBOTSTXT_OBEY=False 受限抓） ---
# 在 https://en.wikipedia.org/wiki/Special:BotPasswords 生成
# 用户名格式: Account@BotName ；只勾选 Basic rights 即可
WIKI_USERNAME=
WIKI_BOT_PASSWORD=
